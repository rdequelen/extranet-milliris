# Valeurs par defaut, VERSIONNEES. Ne mets jamais de secret reel ici.
# Pour surcharger sur une machine donnee, cree un `.env.local` (deja ignore par git).
#
# Les fichiers suivants sont charges s'ils existent, le dernier gagnant sur le precedent :
#   .env  <  .env.local  <  .env.$APP_ENV  <  .env.$APP_ENV.local

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=59ac659a7a3792986b0eb03caeabeee3
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# URL utilisee pour generer des liens absolus hors contexte HTTP (commandes console).
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> symfony/mailer ###
# Le courriel est le SEUL moyen d'entrer dans l'application (lien de connexion).
# `null://null` = aucun envoi : a surcharger dans .env.local par un vrai
# transport (par exemple `smtp://user:pass@smtp.example.com:587`), sinon
# personne ne peut se connecter. En dev, le lien est aussi ecrit dans le journal
# (App\Security\LoginLinkSender) pour pouvoir se connecter sans SMTP.
MAILER_DSN=null://null
MAILER_FROM="Extranet MILLIRIS <no-reply@milliris.com>"
###< symfony/mailer ###

###> doctrine/doctrine-bundle ###
# Format : https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# La version du serveur DOIT etre renseignee, ici ou dans config/packages/doctrine.yaml.
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###
