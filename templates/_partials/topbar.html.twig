{#
    En-tete de page.

    Attendus (passes par base.html.twig, include `only`) :
      - breadcrumb   : liste de { label, path? } ; le dernier element est la page courante
      - page_actions : HTML deja rendu du bloc `page_actions` du gabarit enfant

    L'identite affichee est celle de l'utilisateur AUTHENTIFIE (`app.user`,
    App\Entity\User) : ce gabarit n'est rendu que dans l'application connectee.
#}
<header class="socle-topbar">
    <button type="button"
            class="socle-icon-btn d-lg-none"
            data-bs-toggle="offcanvas"
            data-bs-target="#socleSidebar"
            aria-controls="socleSidebar"
            aria-label="Ouvrir le menu">
        <i class="bi bi-list" aria-hidden="true"></i>
    </button>

    <div class="socle-topbar__trail">
        <nav aria-label="Fil d'ariane">
            <ol class="breadcrumb">
                {% if breadcrumb is empty %}
                    <li class="breadcrumb-item active" aria-current="page">Accueil</li>
                {% else %}
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                {% endif %}
                {% for step in breadcrumb %}
                    {% if loop.last or step.path is not defined %}
                        <li class="breadcrumb-item active" aria-current="page">{{ step.label }}</li>
                    {% else %}
                        <li class="breadcrumb-item"><a href="{{ step.path }}">{{ step.label }}</a></li>
                    {% endif %}
                {% endfor %}
            </ol>
        </nav>
    </div>

    <div class="socle-topbar__actions">
        {# Zone d'actions de page : remplie par {% block page_actions %} dans les gabarits. #}
        {% if page_actions|trim is not empty %}
            <div class="d-flex align-items-center gap-2">{{ page_actions|raw }}</div>
        {% endif %}

        <button type="button"
                class="socle-icon-btn"
                data-controller="theme"
                data-action="theme#toggle"
                aria-pressed="false"
                aria-label="Basculer le theme">
            <i class="bi bi-moon-stars" data-theme-target="icon" aria-hidden="true"></i>
        </button>

        {#
            Bloc identite. La pastille porte les initiales de la personne, la
            premiere ligne son nom et la seconde sa societe : c'est la societe
            qui dit « au nom de qui je regarde ces donnees ».
        #}
        {% if app.user %}
            <div class="dropdown">
                <button type="button"
                        class="socle-identity"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">
                    <span class="socle-identity__avatar" aria-hidden="true">{{ app.user.initials }}</span>
                    <span class="socle-identity__text d-none d-sm-block">
                        <span class="socle-identity__name">{{ app.user.displayName }}</span>
                        <span class="socle-identity__role">{{ app.user.client.name }}</span>
                    </span>
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <span class="dropdown-item-text">
                            <span class="d-block fw-semibold">{{ app.user.displayName }}</span>
                            <span class="d-block small text-body-secondary">{{ app.user.email }}</span>
                            <span class="d-block small text-body-secondary">
                                {{ app.user.client.name }} ({{ app.user.client.code }}) — {{ app.user.roleLabel }}
                            </span>
                        </span>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        {#
                            `logout_path()` ajoute lui-meme le jeton CSRF exige
                            par `logout.enable_csrf` : ne pas remplacer par un
                            path() sur la route app_logout.

                            `data-turbo="false"` force un vrai rechargement :
                            une deconnexion change la session, et le cache de
                            Turbo Drive pourrait sinon re-afficher une page
                            connectee au retour arriere.
                        #}
                        <a class="dropdown-item" href="{{ logout_path('main') }}" data-turbo="false">
                            <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Se deconnecter
                        </a>
                    </li>
                </ul>
            </div>
        {% endif %}
    </div>
</header>
